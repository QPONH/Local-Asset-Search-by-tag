<Window x:Class="LocalAssetSearch.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="历史记录" Icon="pack://application:,,,/Assets/app-32.png" Width="820" Height="520" MinWidth="620" MinHeight="360" Background="{DynamicResource Brush.Window}" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="最近打开 / 最近关闭的文件夹（各保留 10 个）" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="2,0,0,10"/>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,6,0">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="清空" Padding="8,3" Click="ClearOpen_Click"/>
      <TextBlock x:Name="OpenTitle" Text="最近打开" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock x:Name="OpenEmpty" DockPanel.Dock="Top" Text="暂无记录" Foreground="{DynamicResource Brush.Muted}" Margin="4,10" Visibility="Collapsed"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="OpenList"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource Brush.Soft}" CornerRadius="6" Padding="9,7" Margin="0,0,0,5" ToolTip="{Binding Path}">
       <StackPanel>
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" FontSize="13"/>
        <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" Margin="0,3,0,0"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </DockPanel>
   </Border>

   <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="6,0,0,0">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="清空" Padding="8,3" Click="ClearClose_Click"/>
      <TextBlock x:Name="CloseTitle" Text="最近关闭" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock x:Name="CloseEmpty" DockPanel.Dock="Top" Text="暂无记录" Foreground="{DynamicResource Brush.Muted}" Margin="4,10" Visibility="Collapsed"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="CloseList"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource Brush.Soft}" CornerRadius="6" Padding="9,7" Margin="0,0,0,5" ToolTip="{Binding Path}">
       <StackPanel>
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" FontSize="13"/>
        <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Brush.Muted}" FontSize="11" Margin="0,3,0,0"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
