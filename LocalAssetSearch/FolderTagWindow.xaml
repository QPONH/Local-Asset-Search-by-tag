<Window x:Class="LocalAssetSearch.FolderTagWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="管理文件夹标签" Icon="pack://application:,,,/Assets/app-32.png" Height="660" Width="1020" MinHeight="480" MinWidth="780" Background="{DynamicResource Brush.Window}" WindowStartupLocation="CenterOwner">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Muted}" Margin="3,0,3,10"
             Text="在左侧勾选一个或多个文件夹，再点右侧标签即可批量添加或移除。标签框是实心勾表示所选文件夹都带该标签，半选（■）表示只有一部分带；对半选的标签再点一次会把它们全部去掉。"/>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>

   <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
    <DockPanel>
     <TextBox x:Name="FolderFilter" DockPanel.Dock="Top" ToolTip="输入路径中的片段，只显示匹配的文件夹" TextChanged="FolderFilter_TextChanged"/>
     <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock x:Name="SelectionInfo" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}"/>
      <StackPanel Orientation="Horizontal">
       <Button Content="全选可见" Click="SelectAll_Click"/>
       <Button Content="清空选择" Click="ClearSelection_Click"/>
      </StackPanel>
     </DockPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><StackPanel x:Name="FolderPanel"/></ScrollViewer>
    </DockPanel>
   </Border>

   <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="标签" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,6"/>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBox x:Name="NewTagBox" ToolTip="输入新标签名，然后点下面的按钮创建并应用"/>
      <Button Content="新建标签并应用" Click="NewTag_Click"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TagTogglePanel"/></ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>

  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click" IsCancel="True"/>
   <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}"/>
  </DockPanel>
 </Grid>
</Window>
