<Window x:Class="LocalAssetSearch.TagManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="标签管理" Icon="pack://application:,,,/Assets/app-32.png" Height="700" Width="880" MinHeight="500" MinWidth="720" Background="{DynamicResource Brush.Window}" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Muted}" Margin="3,0,3,8"
             Text="在列表里改名、选择分类、标记删除，最后点右下角「保存」统一写入；分类也可以先单独新增。删除标签只会解除它在文件夹上的关联，不会影响磁盘上的原始目录。"/>

  <Grid Grid.Row="1" Margin="0,0,0,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="1.5*"/><ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <TextBox Grid.Column="0" x:Name="NewTagName" ToolTip="新标签名" VerticalContentAlignment="Center"/>
   <ComboBox Grid.Column="1" x:Name="NewTagCategory" ToolTip="选择分类；新分类先在右边「新增分类」里加" VerticalContentAlignment="Center"/>
   <Button Grid.Column="2" Content="加入列表" Click="NewTag_Click" ToolTip="先放进下面的列表，点保存时才写入"/>
   <TextBox Grid.Column="3" x:Name="NewCategoryName" ToolTip="单独新增一个分类" VerticalContentAlignment="Center"/>
   <Button Grid.Column="4" Content="新增分类" Click="NewCategory_Click" ToolTip="只新增分类，不创建标签"/>
  </Grid>

  <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
   <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
     <TextBlock Grid.Column="0" Text="标签名" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}"/>
     <TextBlock Grid.Column="1" Text="分类" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}"/>
     <TextBlock Grid.Column="2" Text="使用数" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}"/>
     <TextBlock Grid.Column="3" Text="操作" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}"/>
    </Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="RowPanel"/></ScrollViewer>
   </DockPanel>
  </Border>

  <DockPanel Grid.Row="3" Margin="0,10,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="SaveButton" Content="保存" Click="Save_Click" Padding="18,6" FontWeight="SemiBold" ToolTip="把所有改动统一写入数据库"/>
    <Button Content="关闭" Click="Close_Click" IsCancel="True"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"/>
  </DockPanel>
 </Grid>
</Window>
