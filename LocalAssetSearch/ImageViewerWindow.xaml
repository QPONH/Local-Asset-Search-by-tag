<Window x:Class="LocalAssetSearch.ImageViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="看图" Icon="pack://application:,,,/Assets/app-32.png" Height="900" Width="1200" MinHeight="420" MinWidth="620" WindowState="Maximized" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Background="{DynamicResource Brush.Window}" PreviewKeyDown="Window_PreviewKeyDown">
 <Grid Background="{DynamicResource Brush.Window}" MouseLeftButtonUp="Surface_Click">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Image x:Name="Picture" Grid.Row="0" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
  <DockPanel Grid.Row="1" Margin="12,4,12,12">
   <TextBlock x:Name="InfoText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" TextTrimming="CharacterEllipsis"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <TextBlock Text="点击任意处 / ← → 翻页　A 自动翻页　Ctrl+W / Esc 关闭" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="11" Foreground="{DynamicResource Brush.Muted}"/>
    <ComboBox x:Name="IntervalBox" Width="124" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="Interval_Changed" ToolTip="自动翻页间隔。最后一页会等满一个间隔后自动关闭，点任意处也会关闭。"><ComboBoxItem Content="不自动翻页"/><ComboBoxItem Content="每 2 秒"/><ComboBoxItem Content="每 3 秒"/><ComboBoxItem Content="每 5 秒"/><ComboBoxItem Content="每 10 秒"/></ComboBox>
    <Button Content="‹ 上一张" Padding="10,4" Click="Prev_Click"/>
    <Button Content="下一张 ›" Padding="10,4" Click="Next_Click"/>
    <Button Content="关闭" Padding="10,4" Click="Close_Click" IsCancel="True"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</Window>
