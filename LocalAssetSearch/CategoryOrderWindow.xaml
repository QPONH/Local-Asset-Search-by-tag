<Window x:Class="LocalAssetSearch.CategoryOrderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="分类顺序" Icon="pack://application:,,,/Assets/app-32.png" Height="480" Width="380" MinHeight="300" MinWidth="320" Background="{DynamicResource Brush.Window}" WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Muted}" Margin="3,0,3,8"
             Text="用 ↑ ↓ 调整标签组的显示顺序（作者、题材……）。改完立即生效，所有标签界面都按这个顺序显示。"/>

  <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" CornerRadius="10" Padding="10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="RowPanel"/></ScrollViewer>
  </Border>

  <DockPanel Grid.Row="2" Margin="0,10,0,0">
   <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click" IsCancel="True"/>
   <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"/>
  </DockPanel>
 </Grid>
</Window>
