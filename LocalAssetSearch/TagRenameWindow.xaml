<Window x:Class="LocalAssetSearch.TagRenameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="编辑标签文字" Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Brush.Window}">
 <StackPanel Margin="16">
  <TextBlock Text="新的标签文字" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
  <TextBox x:Name="NameBox" Margin="0,8,0,0" Padding="7,5" VerticalContentAlignment="Center" FontSize="14"/>
  <TextBlock Text="只修改标签文字；文件夹上的标签关联按 TagId 保留，不会重新对应。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="0,8,0,0"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="保存" IsDefault="True" Padding="16,5" Click="Ok_Click"/>
   <Button Content="取消" IsCancel="True" Padding="16,5"/>
  </StackPanel>
 </StackPanel>
</Window>
